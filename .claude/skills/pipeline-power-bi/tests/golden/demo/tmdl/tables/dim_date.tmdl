/// Calendar covering whole years from the first to the last date in the facts. Marked as date table.
table dim_date
	lineageTag: <guid>
	dataCategory: Time

	/// One row per day; filters every fact table by date.
	column date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Calendar year.
	column year
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	/// Calendar quarter (Q1-Q4).
	column quarter
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	/// Month number 1-12; sorts Month - technical field.
	column month_no
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: month_no

		annotation SummarizationSetBy = Automatic

	/// Month name, sorted by month number.
	column month
		dataType: string
		sortByColumn: month_no
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	/// First day of the month; use it for monthly trends across years.
	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Monday of the week; use it for weekly trends.
	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: week_start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition dim_date = m
		mode: import
		queryGroup: 03_Facts
		source =
				let
					Dates = List.RemoveNulls(List.Combine({fact_orders[dato]})),
					Start = #date(Date.Year(List.Min(Dates)), 1, 1),
					End = #date(Date.Year(List.Max(Dates)), 12, 31),
					Days = List.Dates(Start, Duration.Days(End - Start) + 1, #duration(1, 0, 0, 0)),
					Calendar = Table.FromList(Days, Splitter.SplitByNothing(), type table [Date = date]),
					Year = Table.AddColumn(Calendar, "Year", each Date.Year([Date]), Int64.Type),
					Quarter = Table.AddColumn(Year, "Quarter", each "Q" & Text.From(Date.QuarterOfYear([Date])), type text),
					MonthNo = Table.AddColumn(Quarter, "Month no", each Date.Month([Date]), Int64.Type),
					MonthName = Table.AddColumn(MonthNo, "Month", each Date.ToText([Date], [Format = "MMM", Culture = "en-US"]), type text),
					MonthStart = Table.AddColumn(MonthName, "Month start", each Date.StartOfMonth([Date]), type date),
					WeekStart = Table.AddColumn(MonthStart, "Week start", each Date.StartOfWeek([Date], Day.Monday), type date),
					Renamed = Table.RenameColumns(WeekStart, {{"Date", "date"}, {"Year", "year"}, {"Quarter", "quarter"}, {"Month no", "month_no"}, {"Month", "month"}, {"Month start", "month_start"}, {"Week start", "week_start"}})
				in
					Renamed

	annotation PBI_ResultType = Table
