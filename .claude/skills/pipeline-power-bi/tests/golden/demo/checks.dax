// Control check for Demo (run). Written by build-docs.js.
// Power BI Desktop → Refresh → DAX query view (left bar) → paste this → Run.
// Every Difference should be 0. Expected values: expected-values.md (computed from the source files).

EVALUATE
VAR Checks =
    {
        ( "fact_orders rows", COUNTROWS ( fact_orders ), 11 ),
        ( "fact_orders sum of beloeb", SUM ( fact_orders[beloeb] ), 4049.7 ),
        ( "fact_orders sum of kanal", SUM ( fact_orders[kanal] ), 210 ),
        ( "dim_customers rows", COUNTROWS ( dim_customers ), 6 ),
        ( "fact_orders rows without dim_customers", COUNTROWS ( FILTER ( 'fact_orders', ISBLANK ( RELATED ( 'dim_customers'[kunde_id] ) ) ) ), 0 ),
        ( "fact_orders rows without dim_date", COUNTROWS ( FILTER ( 'fact_orders', ISBLANK ( RELATED ( 'dim_date'[date] ) ) ) ), 0 )
    }
RETURN
    SELECTCOLUMNS (
        Checks,
        "Check", [Value1],
        "In Power BI", [Value2],
        "Expected", [Value3],
        "Difference", ROUND ( [Value2] - [Value3], 2 )
    )
