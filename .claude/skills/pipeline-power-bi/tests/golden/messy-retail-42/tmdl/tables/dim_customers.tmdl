/// Drafted from dim_customers.csv.
table dim_customers
	lineageTag: <guid>

	column customer_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column customer_name
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: customer_name

		annotation SummarizationSetBy = Automatic

	column segment
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: segment

		annotation SummarizationSetBy = Automatic

	column region
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: region

		annotation SummarizationSetBy = Automatic

	column signup_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: signup_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column is_inferred
		dataType: boolean
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: is_inferred

		annotation SummarizationSetBy = Automatic

	partition dim_customers = m
		mode: import
		queryGroup: 02_Dimensions
		source =
				let
					Source = stg_dim_customers,
					#"F18 Missing customer_id values" = let
						Known = List.Transform(Table.Column(Source, "customer_id"), each Text.Lower(Text.From(_))),
						Used = List.Distinct(List.RemoveNulls(List.Combine({Table.Column(stg_fact_orders, "customer_id")})))
					in
						List.Distinct(List.Select(Used, each not List.Contains(Known, Text.Lower(Text.From(_)))), Comparer.OrdinalIgnoreCase),
					#"F18 Add missing customer_id values" = Table.Combine({if Table.HasColumns(Source, "IsInferred") then Source else Table.AddColumn(Source, "IsInferred", each false, type logical), Table.FromRecords(List.Transform(#"F18 Missing customer_id values", each [customer_id = _, IsInferred = true]))}),
					#"M10 Select and name columns" = Table.RenameColumns(Table.SelectColumns(#"F18 Add missing customer_id values", {"customer_id", "customer_name", "segment", "region", "signup_date", "IsInferred"}), {{"IsInferred", "is_inferred"}}),
					#"M99 Set final types" = Table.TransformColumnTypes(#"M10 Select and name columns", {{"customer_id", type text}, {"customer_name", type text}, {"segment", type text}, {"region", type text}, {"signup_date", type date}, {"is_inferred", type logical}})
				in
					#"M99 Set final types"

	annotation PBI_ResultType = Table
