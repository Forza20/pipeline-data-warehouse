/// Drafted from fact_orders.csv.
table fact_orders
	lineageTag: <guid>

	column order_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column order_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: order_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column customer_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: customer_id

		annotation SummarizationSetBy = Automatic

	column product_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	column location_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: location_id

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: #,0
		lineageTag: <guid>
		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	column unit_price
		dataType: double
		formatString: #,0.00
		lineageTag: <guid>
		summarizeBy: sum
		sourceColumn: unit_price

		annotation SummarizationSetBy = Automatic

	column amount
		dataType: double
		formatString: #,0.00
		lineageTag: <guid>
		summarizeBy: sum
		sourceColumn: amount

		annotation SummarizationSetBy = Automatic

	column status
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: status

		annotation SummarizationSetBy = Automatic

	column is_paid
		dataType: boolean
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: is_paid

		annotation SummarizationSetBy = Automatic

	column amount_issue
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: amount_issue

		annotation SummarizationSetBy = Automatic

	partition fact_orders = m
		mode: import
		queryGroup: 03_Facts
		source =
				let
					Source = stg_fact_orders,
					#"M10 Select and name columns" = Table.RenameColumns(Table.SelectColumns(Source, {"order_id", "order_date", "customer_id", "product_id", "location_id", "quantity", "unit_price", "amount", "status", "is_paid", "amount issue"}), {{"amount issue", "amount_issue"}}),
					#"M99 Set final types" = Table.TransformColumnTypes(#"M10 Select and name columns", {{"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"location_id", type text}, {"quantity", Int64.Type}, {"unit_price", type number}, {"amount", type number}, {"status", type text}, {"is_paid", type logical}, {"amount_issue", type text}})
				in
					#"M99 Set final types"

	annotation PBI_ResultType = Table
