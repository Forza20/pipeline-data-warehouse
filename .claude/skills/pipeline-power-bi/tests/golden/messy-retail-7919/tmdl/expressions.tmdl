/// Staging (not loaded): undefined, with its cleaning steps.
expression stg_fact_orders =
		let
			Source = Csv.Document(File.Contents(SourceFolder & "fact_orders.csv"), [Delimiter = ",", Columns = 10, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			#"F01 Promote headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			#"F01 Keep data columns" = Table.SelectColumns(#"F01 Promote headers", {"order_id", "order_date", "customer_id", "product_id", "location_id", "quantity", "unit_price", "amount", "status", "is_paid"}),
			#"F11 Normalise customer_id" = Table.TransformColumns(#"F01 Keep data columns", {{"customer_id", each fnNormaliseId(_, "CUST", "-", 4), type text}}),
			#"F11 Normalise product_id" = Table.TransformColumns(#"F11 Normalise customer_id", {{"product_id", each fnNormaliseId(_, "PROD", "-", 4), type text}}),
			#"F08 Parse order_date" = Table.TransformColumns(#"F11 Normalise product_id", {{"order_date", each fnParseDate(_, true), type nullable date}}),
			#"F09 Parse amount" = Table.TransformColumns(#"F08 Parse order_date", {{"amount", each fnParseNumber(_), type nullable number}}),
			#"F10 Parse is_paid" = Table.TransformColumns(#"F09 Parse amount", {{"is_paid", each fnParseBool(_), type nullable logical}}),
			#"F12 Remove exact duplicates" = Table.Distinct(#"F10 Parse is_paid"),
			#"F13 Keep first row per order_id" = Table.Distinct(Table.Buffer(#"F12 Remove exact duplicates"), {"order_id", Comparer.OrdinalIgnoreCase}),
			#"F14 Flag amount" = Table.AddColumn(#"F13 Keep first row per order_id", "amount issue", each if [amount] = null then "missing" else if [amount] < 0 then "negative" else if [amount] > 6001.8 then "spike" else "ok", type text),
			#"F17 Empty text to null" = Table.TransformColumns(#"F14 Flag amount", List.Transform({"order_id", "order_date", "customer_id", "product_id", "location_id", "quantity", "unit_price", "amount", "status", "is_paid"}, (c) => {c, each if _ = "" then null else _})),
			#"F17 Set types" = Table.TransformColumnTypes(#"F17 Empty text to null", {{"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"location_id", type text}, {"quantity", Int64.Type}, {"unit_price", type number}, {"amount", type number}, {"status", type text}, {"is_paid", type logical}}, "en-US")
		in
			#"F17 Set types"
	lineageTag: <guid>
	queryGroup: 01_Stage

	annotation PBI_ResultType = Table

