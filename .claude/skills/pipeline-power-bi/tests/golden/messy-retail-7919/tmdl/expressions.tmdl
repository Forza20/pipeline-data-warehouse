/// Staging (not loaded): undefined, with its cleaning steps.
expression stg_wide_monthly_targets =
		let
			Source = Csv.Document(File.Contents(SourceFolder & "wide_monthly_targets.csv"), [Delimiter = ",", Columns = 14, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			#"F01 Promote headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			#"F01 Keep data columns" = Table.SelectColumns(#"F01 Promote headers", {"location_id", "year", "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"}),
			#"F16 Unpivot Period" = Table.UnpivotOtherColumns(#"F01 Keep data columns", {"location_id", "year"}, "Period", "Value"),
			#"F16 Period as date" = Table.AddColumn(#"F16 Unpivot Period", "Period start", each #date(Number.From([year]), List.PositionOf({"jan","feb","mar","apr","may","jun","jul","aug","sep","oct","nov","dec"}, Text.Lower(Text.Start(Text.Replace(Text.Replace([Period], "maj", "may"), "okt", "oct"), 3))) + 1, 1), type date),
			#"F17 Empty text to null" = Table.TransformColumns(#"F16 Period as date", List.Transform({"location_id", "year", "Period", "Value"}, (c) => {c, each if _ = "" then null else _})),
			#"F17 Set types" = Table.TransformColumnTypes(#"F17 Empty text to null", {{"location_id", type text}, {"year", Int64.Type}, {"Period", type text}, {"Value", type number}}, "en-US")
		in
			#"F17 Set types"
	lineageTag: <guid>
	queryGroup: 01_Stage

	annotation PBI_ResultType = Table
