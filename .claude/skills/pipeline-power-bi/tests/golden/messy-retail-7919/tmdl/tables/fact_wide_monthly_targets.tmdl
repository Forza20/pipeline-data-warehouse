/// Drafted from wide_monthly_targets.csv.
table fact_wide_monthly_targets
	lineageTag: <guid>

	column location_id
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: location_id

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: #,0
		lineageTag: <guid>
		summarizeBy: sum
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column period
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: period

		annotation SummarizationSetBy = Automatic

	column value
		dataType: double
		formatString: #,0.00
		lineageTag: <guid>
		summarizeBy: sum
		sourceColumn: value

		annotation SummarizationSetBy = Automatic

	column period_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: <guid>
		summarizeBy: none
		sourceColumn: period_start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fact_wide_monthly_targets = m
		mode: import
		queryGroup: 03_Facts
		source =
				let
					Source = stg_wide_monthly_targets,
					#"M10 Select and name columns" = Table.RenameColumns(Table.SelectColumns(Source, {"location_id", "year", "Period", "Value", "Period start"}), {{"Period", "period"}, {"Value", "value"}, {"Period start", "period_start"}}),
					#"M99 Set final types" = Table.TransformColumnTypes(#"M10 Select and name columns", {{"location_id", type text}, {"year", Int64.Type}, {"period", type text}, {"value", type number}, {"period_start", type date}})
				in
					#"M99 Set final types"

	annotation PBI_ResultType = Table
